# BASE44 (required for local dev)
VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# Local dev only — skip BASE44 login (never enable in production)
# VITE_DEV_AUTH_BYPASS=true

# Local dev only — use localStorage demo data instead of BASE44 API
# VITE_DEV_DATA_BYPASS=true

# Optional — for scripts/seedPilotDemo.mjs (copy access token after login)
BASE44_ACCESS_TOKEN=

# Legacy / future Supabase (not used by BASE44 pilot app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
