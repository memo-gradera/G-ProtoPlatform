# BASE44 (legacy pilot — required when VITE_AUTH_PROVIDER=base44)
VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# Authentication provider: local | msal | base44
# Default when unset: base44 (legacy compatibility)
VITE_AUTH_PROVIDER=local

# Data backend: local | api | base44
# Default when unset: base44 (legacy compatibility)
VITE_BACKEND_PROVIDER=local

# --- Local pilot mode (default for development) ---
VITE_DEV_AUTH_BYPASS=true
VITE_DEV_DATA_BYPASS=true

# --- Production / Azure mode ---
# VITE_AUTH_PROVIDER=msal
# VITE_BACKEND_PROVIDER=api
# VITE_DEV_AUTH_BYPASS=false
# VITE_DEV_DATA_BYPASS=false
# VITE_AZURE_TENANT_ID=
# VITE_AZURE_CLIENT_ID=
# VITE_API_SCOPE=api://<api-client-id>/access_as_user
# VITE_API_BASE_URL=http://localhost:8080/api

# Microsoft Entra ID (MSAL — required when VITE_AUTH_PROVIDER=msal)
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_API_SCOPE=
VITE_API_BASE_URL=http://localhost:8080/api

# Optional temporary auth diagnostics (development only)
# VITE_AUTH_DEBUG=true

# Optional — for scripts/seedPilotDemo.mjs (copy access token after login)
BASE44_ACCESS_TOKEN=

# Legacy / future Supabase (not used by current pilot app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
