# Server
PORT=3001
NODE_ENV=development

# Frontend (Azure Static Web Apps local dev / Vite)
CORS_ORIGIN=http://localhost:5173

# Azure PostgreSQL (local Docker or Azure Database for PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gradera_innovation_hub?schema=public

# Microsoft Entra ID (JWT validation)
# Directory (tenant) ID from Azure Portal → Microsoft Entra ID → Overview
AZURE_TENANT_ID=
# Application (client) ID from the API app registration
AZURE_CLIENT_ID=
# Token audience — use the API Application ID URI (api://<client-id>) or client ID,
# matching the "aud" claim on access tokens issued to the frontend.
JWT_AUDIENCE=

# Local development auth bypass (ignored when NODE_ENV=production)
# When true and no Authorization header is sent, uses seeded admin@gradera.local
DEV_AUTH_BYPASS=true

# When true in non-production, auto-create viewer users for valid Entra tokens
# that are not yet provisioned in PostgreSQL. Never enabled in production.
AUTO_PROVISION_DEV_USERS=false

